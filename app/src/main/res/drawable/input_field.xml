<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape>
        <solid android:color="@color/rc_field" />
        <stroke android:width="1dp" android:color="@color/rc_primary" />
        <corners android:radius="14dp" />
    </shape></item>
    <item><shape>
        <solid android:color="@color/rc_field" />
        <stroke android:width="1dp" android:color="@color/rc_line" />
        <corners android:radius="14dp" />
    </shape></item>
</selector>

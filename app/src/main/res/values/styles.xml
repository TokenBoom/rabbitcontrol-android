<resources>
    <style name="SessionTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rc_chrome</item>
        <item name="android:statusBarColor">@color/rc_chrome</item>
        <item name="android:navigationBarColor">@color/rc_chrome</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="RcHeading">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/rc_text</item>
    </style>
    <style name="RcLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/rc_text</item>
    </style>
    <style name="RcBody">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/rc_muted</item>
    </style>
    <style name="RcInput" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/input_field</item>
        <item name="android:textColor">@color/rc_text</item>
        <item name="android:textColorHint">@color/rc_muted</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="RcButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="RcButton.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/button_secondary_text</item>
    </style>
</resources>

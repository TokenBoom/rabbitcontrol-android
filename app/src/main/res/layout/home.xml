<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="@dimen/page_margin"
        android:paddingVertical="24dp" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/rabbitcontrol" android:importantForAccessibility="no" />
            <TextView style="@style/RcHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/app_name" android:textSize="28sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="24dp"
            android:padding="20dp" android:background="@drawable/panel">
            <TextView style="@style/RcHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/server_title" android:accessibilityHeading="true" />
            <TextView style="@style/RcLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/address_label" android:labelFor="@id/address" />
            <EditText style="@style/RcInput" android:id="@+id/address" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:singleLine="true"
                android:importantForAutofill="no" android:inputType="textUri" android:hint="@string/api_hint" />
            <TextView style="@style/RcLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/pin_label" android:labelFor="@id/fingerprint" />
            <EditText style="@style/RcInput" android:id="@+id/fingerprint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:singleLine="true"
                android:importantForAutofill="no" android:inputType="textNoSuggestions" android:hint="@string/pin_hint" />
            <Button style="@style/RcButton" android:id="@+id/probe" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/probe_server" />
            <TextView style="@style/RcBody" android:id="@+id/probeResult" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"
                android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="16dp"
            android:padding="20dp" android:background="@drawable/panel">
            <TextView style="@style/RcHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/preview_title" android:accessibilityHeading="true" />
            <TextView style="@style/RcBody" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/preview_summary" />
            <Button style="@style/RcButton.Secondary" android:id="@+id/preview" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/start_preview" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
